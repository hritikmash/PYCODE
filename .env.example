# Built-in Turbo AI server key (never expose to frontend; never shared with external BYOM connectors)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-side AES-256 secret used to encrypt user-supplied BYOM external credentials at rest
CREDENTIAL_ENCRYPTION_SECRET=""

# Allowed CORS origins for FastAPI backend (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional FastAPI backend URL if deploying frontend separately on Vercel
VITE_API_BASE_URL=""
